<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/static/site.css" />
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="brand">Movie Aggregator</a>
      <form method="post" action="/admin/logout"><button class="btn ghost">Logout</button></form>
    </header>
    <main class="stack">
      <section class="hero">
        <h1>Admin Dashboard</h1>
        <p>Add movies, ratings, and manage platform data quickly.</p>
      </section>

      <section class="grid two">
        <form class="card stack" action="/admin/movies" method="post">
          <h3>Add Movie</h3>
          <input name="title" placeholder="Title" required />
          <input name="year" type="number" placeholder="Year" required />
          <input name="genres" placeholder="Genres comma separated" />
          <input name="synopsis" placeholder="Synopsis" />
          <button class="btn" type="submit">Create Movie</button>
        </form>

        <form class="card stack" action="/admin/ratings" method="post">
          <h3>Add Rating</h3>
          <select name="movieId" required>
            <% movies.forEach(function(m){ %><option value="<%= m.id %>"><%= m.title %></option><% }) %>
          </select>
          <select name="sourceId" required>
            <% sources.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
          </select>
          <input name="rawValue" type="number" step="0.1" placeholder="Raw score" required />
          <button class="btn" type="submit">Add Rating</button>
        </form>
      </section>
    </main>
    <script src="/static/site.js"></script>
  </body>
</html>
